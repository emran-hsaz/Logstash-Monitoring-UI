# Environment for the lsdash service (/etc/lsmon/lsdash.env). Keep this file mode 0640.
# Login for people opening the dashboard (strongly recommended when bind is not 127.0.0.1):
LSDASH_USER=ops
LSDASH_PASSWORD=change-me
# Logstash API login shared by all nodes, if the API requires one:
#LS_API_USER=monitor
#LS_API_PASSWORD=change-me
